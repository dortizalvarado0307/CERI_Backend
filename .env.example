# Prisma database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ceri"

# JWT secret (use a high-entropy string, e.g. openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# JWT expiration time
JWT_EXPIRES_IN=8h

# Bcrypt salt rounds (default: 10)
BCRYPT_SALT_ROUNDS=10

# Server port
PORT=3000